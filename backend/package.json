{
  "name": "bware-backend",
  "version": "1.0.0",
  "description": "Backend for AI Fake News + Policy Claim Verifier",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seeders/worldBankSeeder.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "test:watch": "cross-env NODE_ENV=test jest --watch --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 10000,
    "clearMocks": true,
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.18.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "rate-limit-redis": "^4.3.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "supertest-session": "^5.0.1"
  }
}
